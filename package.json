{
  "name": "vscodium-langservers-extracted",
  "version": "1.112.01907",
  "description": "Extract HTML/CSS/JSON/ESLint language servers from official builds of VS Codium.",
  "author": "Scott Hallock <scott@hallocks.net> (https://github.com/scotthal)",
  "repository": {
    "type": "git",
    "url": "https://github.com//scotthal/vscodium-langservers-extracted"
  },
  "homepage": "https://github.com/scotthal/vscodium-langservers-extracted",
  "type": "commonjs",
  "files": [
    "bin/"
  ],
  "bin": {
    "vscode-css-language-server": "bin/vscode-css-language-server",
    "vscode-eslint-language-server": "bin/vscode-eslint-language-server",
    "vscode-html-language-server": "bin/vscode-html-language-server",
    "vscode-json-language-server": "bin/vscode-json-language-server",
    "vscode-markdown-language-server": "bin/vscode-markdown-language-server"
  },
  "config": {
    "deploy_vscodium_url": "https://github.com/VSCodium/vscodium/releases/download/1.112.01907/VSCodium-linux-x64-1.112.01907.tar.gz",
    "deploy_eslint_url": "https://open-vsx.org/api/dbaeumer/vscode-eslint/3.0.24/file/dbaeumer.vscode-eslint-3.0.24.vsix"
  },
  "scripts": {
    "build": "sh ./extract-langservers.sh -v -l -n -o ./bin/",
    "build-for-deploy": "sh ./extract-langservers.sh -v -c $npm_package_config_deploy_vscodium_url -e $npm_package_config_deploy_eslint_url -n -o ./bin/"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "verdaccio": "^6.3.2"
  }
}
